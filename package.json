{
  "name": "upnext-backend",
  "version": "0.1.0",
  "private": true,
  "description": "UpNext IT recruitment backend built with NestJS, Prisma and PostgreSQL.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --browser none",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-posts": "tsx prisma/seed-posts.ts",
    "prisma:seed-company-photos": "tsx scripts/backfill-company-photos.ts",
    "generate:company-workplace-images": "tsx scripts/generate-company-workplace-images.ts",
    "chat:seed-permissions": "tsx scripts/seed-chat-permissions.ts",
    "chat:backfill": "tsx scripts/backfill-chat.ts",
    "db:reset": "prisma migrate reset",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/platform-socket.io": "11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "latest",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "11.1.26",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@scalar/nestjs-api-reference": "^1.2.2",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "cloudinary": "^2.10.0",
    "dotenv": "latest",
    "express": "5.2.1",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.9.0",
    "helmet": "latest",
    "nodemailer": "^9.0.0",
    "passport": "latest",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "latest",
    "pdf-parse": "^2.4.5",
    "pg": "latest",
    "prisma": "7.8.0",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "socket.io": "4.8.1",
    "tsx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@eslint/js": "latest",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "latest",
    "@types/pg": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "exceljs": "^4.4.0",
    "globals": "latest",
    "husky": "latest",
    "jest": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "source-map-support": "latest",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-loader": "latest",
    "ts-node": "latest",
    "tsconfig-paths": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
