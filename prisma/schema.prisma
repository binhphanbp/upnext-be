}

enum MessageType {
  TEXT       @map("text")
  ATTACHMENT @map("attachment")
  MIXED      @map("mixed")
  SYSTEM     @map("system")
}

enum MessageAttachmentStatus {
  UPLOADED    @map("uploaded")
  CLAIMED     @map("claimed")
  QUARANTINED @map("quarantined")
  DELETED     @map("deleted")
}

enum TalentRecommendationRunStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")
}

enum TalentContactStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
  EXPIRED  @map("expired")
  BLOCKED  @map("blocked")
  CLOSED   @map("closed")
