  TALENT_OUTREACH  @map("talent_outreach")
  SUPPORT          @map("support")
}

enum ConversationStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  READ_ONLY @map("read_only")
  CLOSED    @map("closed")
}

enum ConversationParticipantRole {
  CANDIDATE @map("candidate")
  RECRUITER @map("recruiter")
  ADMIN     @map("admin")
  OBSERVER  @map("observer")
}

enum MessageType {
  TEXT       @map("text")
  ATTACHMENT @map("attachment")
  MIXED      @map("mixed")
  SYSTEM     @map("system")
}

enum MessageAttachmentStatus {
  UPLOADED    @map("uploaded")
  CLAIMED     @map("claimed")
  QUARANTINED @map("quarantined")
  DELETED     @map("deleted")
}

enum TalentRecommendationRunStatus {
  PENDING    @map("pending")
