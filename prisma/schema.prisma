  COMPLETED      @map("completed")
  FAILED         @map("failed")
  PARTIAL_FAILED @map("partial_failed")
  CANCELLED      @map("cancelled")
}

enum EducationLevel {
  ANY          @map("any")
  HIGH_SCHOOL  @map("high_school")
  VOCATIONAL   @map("vocational")
  COLLEGE      @map("college")
  BACHELOR     @map("bachelor")
  POSTGRADUATE @map("postgraduate")
}

enum ConversationType {
