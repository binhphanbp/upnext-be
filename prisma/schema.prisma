  sentByRecruiterId String                      @map("sent_by_recruiter_id") @db.Uuid
  introMessageId    String                      @unique @map("intro_message_id") @db.Uuid
  quotaUsageId      String                      @unique @map("quota_usage_id") @db.Uuid
  clientRequestId   String                      @map("client_request_id") @db.VarChar(100)
  sentAt            DateTime                    @default(now()) @map("sent_at")
  expiresAt         DateTime                    @map("expires_at")
  respondedAt       DateTime?                   @map("responded_at")
  outcome           TalentContactAttemptOutcome @default(PENDING)

  request           TalentContactRequest  @relation("TalentContactAttempts", fields: [requestId], references: [id], onDelete: Restrict)
  currentForRequest TalentContactRequest? @relation("CurrentTalentContactAttempt")
  sentByRecruiter   RecruiterAccount      @relation(fields: [sentByRecruiterId], references: [id], onDelete: Restrict)
  introMessage      Message               @relation(fields: [introMessageId], references: [id], onDelete: Restrict)
  quotaUsage        SubscriptionUsage     @relation(fields: [quotaUsageId], references: [id], onDelete: Restrict)

  @@unique([requestId, clientRequestId])
  @@index([requestId, sentAt])
  @@map("talent_contact_attempts")
}

// =========================
// Support and delivery infrastructure
// =========================

model SupportCase {
  id                     String            @id @default(uuid()) @db.Uuid
  caseNumber             String            @unique @map("case_number") @db.VarChar(30)
  clientRequestId        String            @map("client_request_id") @db.VarChar(100)
  conversationId         String            @unique @map("conversation_id") @db.Uuid
  companyId              String            @map("company_id") @db.Uuid
  createdByRecruiterId   String            @map("created_by_recruiter_id") @db.Uuid
  assignedAdminUserId    String?           @map("assigned_admin_user_id") @db.Uuid
  jobPostId              String?           @map("job_post_id") @db.Uuid
  invoiceId              String?           @map("invoice_id") @db.Uuid
  companySubscriptionId  String?           @map("company_subscription_id") @db.Uuid
  department             SupportDepartment
  categoryCode           String            @map("category_code") @db.VarChar(100)
  priority               SupportPriority   @default(NORMAL)
  status                 SupportCaseStatus @default(NEW)
  title                  String            @db.VarChar(200)
  description            String            @db.Text
  details                Json?
  resolutionCode         String?           @map("resolution_code") @db.VarChar(100)
  resolutionSummary      String?           @map("resolution_summary") @db.Text
  lastRequesterMessageAt DateTime?         @map("last_requester_message_at")
  lastAdminMessageAt     DateTime?         @map("last_admin_message_at")
  resolvedAt             DateTime?         @map("resolved_at")
  closedAt               DateTime?         @map("closed_at")
  version                Int               @default(0)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  conversation        Conversation                   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  company             Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdByRecruiter  RecruiterAccount               @relation("SupportCaseCreatedByRecruiter", fields: [createdByRecruiterId], references: [id], onDelete: Restrict)
  assignedAdmin       AdminUser?                     @relation("SupportCaseAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  jobPost             JobPost?                       @relation(fields: [jobPostId], references: [id], onDelete: Restrict)
  invoice             Invoice?                       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  companySubscription CompanySubscription?           @relation(fields: [companySubscriptionId], references: [id], onDelete: Restrict)
  assignmentHistory   SupportCaseAssignmentHistory[]
  statusHistory       SupportCaseStatusHistory[]

  @@unique([companyId, createdByRecruiterId, clientRequestId])
  @@index([department, status, assignedAdminUserId, priority, updatedAt, id])
  @@index([createdByRecruiterId, status, updatedAt])
  @@index([companyId, status, updatedAt])
  @@index([jobPostId])
  @@index([invoiceId])
  @@index([companySubscriptionId])
  @@map("support_cases")
}

model SupportCaseAssignmentHistory {
  id                   String                  @id @default(uuid()) @db.Uuid
  caseId               String                  @map("case_id") @db.Uuid
  fromAdminUserId      String?                 @map("from_admin_user_id") @db.Uuid
  toAdminUserId        String?                 @map("to_admin_user_id") @db.Uuid
  action               SupportAssignmentAction
  performedByActorType ActorType               @map("performed_by_actor_type")
  performedByActorId   String?                 @map("performed_by_actor_id") @db.Uuid
  reason               String?                 @db.Text
  createdAt            DateTime                @default(now()) @map("created_at")

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  fromAdmin   AdminUser?  @relation("SupportAssignmentFromAdmin", fields: [fromAdminUserId], references: [id], onDelete: SetNull)
  toAdmin     AdminUser?  @relation("SupportAssignmentToAdmin", fields: [toAdminUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("support_case_assignment_histories")
}

model SupportCaseStatusHistory {
  id         String             @id @default(uuid()) @db.Uuid
  caseId     String             @map("case_id") @db.Uuid
  fromStatus SupportCaseStatus? @map("from_status")
  toStatus   SupportCaseStatus  @map("to_status")
  actorType  ActorType          @map("actor_type")
  actorId    String?            @map("actor_id") @db.Uuid
  reason     String?            @db.Text
  createdAt  DateTime           @default(now()) @map("created_at")

  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("support_case_status_histories")
}

model SubscriptionUsage {
  id                    String                     @id @default(uuid()) @db.Uuid
  companySubscriptionId String                     @map("company_subscription_id") @db.Uuid
  companyId             String                     @map("company_id") @db.Uuid
  feature               String                     @db.VarChar(60)
  quantity              Int                        @default(1)
  direction             SubscriptionUsageDirection @default(CONSUME)
  referenceType         String                     @map("reference_type") @db.VarChar(80)
  referenceId           String                     @map("reference_id") @db.Uuid
  idempotencyKey        String                     @unique @map("idempotency_key") @db.VarChar(180)
  createdByRecruiterId  String?                    @map("created_by_recruiter_id") @db.Uuid
  reversedUsageId       String?                    @unique @map("reversed_usage_id") @db.Uuid
  createdAt             DateTime                   @default(now()) @map("created_at")

  companySubscription  CompanySubscription   @relation(fields: [companySubscriptionId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reversedUsage        SubscriptionUsage?    @relation("UsageReversal", fields: [reversedUsageId], references: [id], onDelete: Restrict)
  reversal             SubscriptionUsage?    @relation("UsageReversal")
  talentContactAttempt TalentContactAttempt?

  @@index([companySubscriptionId, feature, createdAt])
  @@index([companyId, feature, createdAt])
  @@index([referenceType, referenceId])
  @@map("subscription_usages")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(80)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(120)
  dedupeKey     String       @unique @map("dedupe_key") @db.VarChar(180)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?    @map("locked_at")
  lockedBy      String?      @map("locked_by") @db.VarChar(100)
  processedAt   DateTime?    @map("processed_at")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// =========================
// AI Copilot
// =========================
// Nhóm chung một khối vì đây là một domain độc lập (xem ADR-001). Enum đặt cạnh
// model thay vì trong khối Enums ở đầu file để cả domain đọc được trong một chỗ.

enum AiConversationContext {
  GENERAL        @map("general")
  CV             @map("cv")
  JOB            @map("job")
  APPLICATION    @map("application")
  MOCK_INTERVIEW @map("mock_interview")
}

enum AiMessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
}

/// Trạng thái một lượt trả lời. PARTIAL = có nội dung nhưng bị cắt giữa
/// (người dùng bấm Dừng, hoặc hết thời gian) — vẫn hiển thị cho người dùng.
enum AiRunStatus {
  PENDING   @map("pending")
  STREAMING @map("streaming")
  COMPLETED @map("completed")
  PARTIAL   @map("partial")
  FAILED    @map("failed")
}

enum AiFeedbackRating {
  UP   @map("up")
  DOWN @map("down")
}

enum AiActionType {
  APPLY_CV_SUGGESTION   @map("apply_cv_suggestion")
  SAVE_JOB              @map("save_job")
  UPDATE_JOB_PREFERENCE @map("update_job_preference")
}

enum AiActionStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  REJECTED  @map("rejected")
  EXPIRED   @map("expired")
  EXECUTED  @map("executed")
  FAILED    @map("failed")
}

model AIConversation {
  id                 String                @id @default(uuid()) @db.Uuid
  actorType          ActorType             @map("actor_type")
  /// Chỉ candidate được hỗ trợ ở bản này. Recruiter/admin thêm cột FK riêng
  /// của mình khi tới lượt — không dùng một cột actorId không có khoá ngoại.
  candidateProfileId String?               @map("candidate_profile_id") @db.Uuid
  contextType        AiConversationContext @default(GENERAL) @map("context_type")
  /// Định danh thực thể của ngữ cảnh. Không đặt FK vì trỏ tới nhiều bảng khác
  /// nhau tuỳ contextType.
  ///
  /// VarChar chứ không phải Uuid: route công khai của tin tuyển dụng là
  /// `/jobs/[slug]`, nên ngữ cảnh JOB mang slug chứ không mang UUID. Khai Uuid
  /// làm mọi hội thoại mở từ trang tin trả 500 — cột từ chối giá trị ở tầng DB,
  /// sau khi DTO đã cho qua.
  contextId          String?               @map("context_id") @db.VarChar(220)
  locale             String                @default("vi") @db.VarChar(5)
  title              String                @default("") @db.VarChar(180)
  isArchived         Boolean               @default(false) @map("is_archived")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  candidateProfile CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  messages         AIMessage[]
  actionRequests   AIActionRequest[]

  @@index([candidateProfileId, isArchived, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String        @default("") @db.Text
  status         AiRunStatus   @default(PENDING)
  intent         String?       @db.VarChar(40)

  /// Ba khối này là dữ liệu hiển thị đã được validate bằng zod trước khi ghi.
  /// Lưu Json vì hình dạng khác nhau theo loại card và sẽ còn thay đổi.
  citationsJson   Json? @map("citations_json")
  cardsJson       Json? @map("cards_json")
  toolCallsJson   Json? @map("tool_calls_json")
  suggestionsJson Json? @map("suggestions_json")

  modelName     String? @map("model_name") @db.VarChar(80)
  promptVersion String? @map("prompt_version") @db.VarChar(60)
  inputTokens   Int?    @map("input_tokens")
  outputTokens  Int?    @map("output_tokens")
  latencyMs     Int?    @map("latency_ms")
  errorCode     String? @map("error_code") @db.VarChar(60)

  createdAt DateTime @default(now()) @map("created_at")

  conversation  AIConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback      AIMessageFeedback?
  actionRequest AIActionRequest?

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AIMessageFeedback {
  id         String           @id @default(uuid()) @db.Uuid
  messageId  String           @unique @map("message_id") @db.Uuid
  actorType  ActorType        @map("actor_type")
  actorId    String           @map("actor_id") @db.Uuid
  rating     AiFeedbackRating
  reasonCode String?          @map("reason_code") @db.VarChar(60)
  comment    String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  message AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("ai_message_feedbacks")
}

/// Human-in-the-loop: AI đề xuất, người dùng xác nhận, BACKEND thực hiện.
/// AI không bao giờ tự ghi dữ liệu nghiệp vụ.
model AIActionRequest {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  messageId      String?        @unique @map("message_id") @db.Uuid
  actorType      ActorType      @map("actor_type")
  actorId        String         @map("actor_id") @db.Uuid
  actionType     AiActionType   @map("action_type")
  /// Nội dung sẽ ghi nếu được xác nhận. Snapshot tại lúc đề xuất — nếu dữ liệu
  /// nguồn đổi sau đó, hành động vẫn ghi đúng thứ người dùng đã thấy và đồng ý.
  payloadJson    Json           @map("payload_json")
  status         AiActionStatus @default(PENDING)
  expiresAt      DateTime       @map("expires_at")
  confirmedAt    DateTime?      @map("confirmed_at")
  executedAt     DateTime?      @map("executed_at")
  failureReason  String?        @map("failure_reason") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AIMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([actorId, status])
  @@map("ai_action_requests")
}

/// Sổ ghi mọi lần gọi AI, tập trung một chỗ (ADR-001 §7 bước 5).
/// Đây là nguồn dữ liệu cho dashboard chi phí và cho chương đánh giá của báo cáo.
model AIRun {
  id               String      @id @default(uuid()) @db.Uuid
  traceId          String      @map("trace_id") @db.VarChar(60)
  actorType        ActorType   @map("actor_type")
  actorId          String?     @map("actor_id") @db.Uuid
  feature          String      @db.VarChar(60)
  intent           String?     @db.VarChar(40)
  modelName        String      @map("model_name") @db.VarChar(80)
  promptVersion    String      @map("prompt_version") @db.VarChar(60)
  inputTokens      Int         @default(0) @map("input_tokens")
  outputTokens     Int         @default(0) @map("output_tokens")
  latencyMs        Int         @default(0) @map("latency_ms")
  toolCallCount    Int         @default(0) @map("tool_call_count")
  status           AiRunStatus @default(PENDING)
  errorCode        String?     @map("error_code") @db.VarChar(60)
  /// Số lần model bị chặn vì gọi tool không thuộc quyền của role. > 0 là tín
  /// hiệu bảo mật, không phải lỗi vận hành.
  blockedToolCount Int         @default(0) @map("blocked_tool_count")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([feature, createdAt])
  @@index([actorId, createdAt])
  @@map("ai_runs")
}
