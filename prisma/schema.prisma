// =========================
// Realtime conversations
// =========================

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  type               ConversationType
  status             ConversationStatus @default(ACTIVE)
  companyId          String?            @map("company_id") @db.Uuid
  applicationId      String?            @unique @map("application_id") @db.Uuid
  jobPostId          String?            @map("job_post_id") @db.Uuid
  latestMessageId    String?            @unique @map("latest_message_id") @db.Uuid
  latestMessageAt    DateTime?          @map("latest_message_at")
  writableUntil      DateTime?          @map("writable_until")
  readOnlyAt         DateTime?          @map("read_only_at")
  closedAt           DateTime?          @map("closed_at")
  closeReason        String?            @map("close_reason") @db.VarChar(120)
  createdByActorType ActorType          @map("created_by_actor_type")
  createdByActorId   String?            @map("created_by_actor_id") @db.Uuid
  metadata           Json?
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  company              Company?                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application          Application?              @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  jobPost              JobPost?                  @relation(fields: [jobPostId], references: [id], onDelete: Restrict)
  latestMessage        Message?                  @relation("ConversationLatestMessage", fields: [latestMessageId], references: [id], onDelete: SetNull)
  messages             Message[]                 @relation("ConversationMessages")
  participants         ConversationParticipant[]
  attachments          MessageAttachment[]
  talentContactRequest TalentContactRequest?
  supportCase          SupportCase?

  @@index([companyId, type, status, latestMessageAt, id])
  @@index([type, status, updatedAt, id])
  @@index([status, writableUntil])
  @@index([jobPostId])
  @@map("conversations")
}

model ConversationParticipant {
  id                 String                      @id @default(uuid()) @db.Uuid
  conversationId     String                      @map("conversation_id") @db.Uuid
  candidateAccountId String?                     @map("candidate_account_id") @db.Uuid
  recruiterAccountId String?                     @map("recruiter_account_id") @db.Uuid
  adminUserId        String?                     @map("admin_user_id") @db.Uuid
  role               ConversationParticipantRole
  joinedAt           DateTime                    @default(now()) @map("joined_at")
  leftAt             DateTime?                   @map("left_at")
  archivedAt         DateTime?                   @map("archived_at")
  mutedUntil         DateTime?                   @map("muted_until")
  explicitlyAdded    Boolean                     @default(false) @map("explicitly_added")
  tags               String[]                    @default([])
  lastReadMessageId  String?                     @map("last_read_message_id") @db.Uuid
  lastReadAt         DateTime?                   @map("last_read_at")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")

  conversation        Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  candidateAccount    CandidateAccount?   @relation(fields: [candidateAccountId], references: [id], onDelete: Restrict)
  recruiterAccount    RecruiterAccount?   @relation(fields: [recruiterAccountId], references: [id], onDelete: Restrict)
  adminUser           AdminUser?          @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  lastReadMessage     Message?            @relation("ParticipantLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)
  sentMessages        Message[]           @relation("ParticipantSentMessages")
  uploadedAttachments MessageAttachment[]

  @@unique([conversationId, candidateAccountId])
  @@unique([conversationId, recruiterAccountId])
  @@unique([conversationId, adminUserId])
  @@index([candidateAccountId, leftAt, conversationId])
  @@index([recruiterAccountId, leftAt, conversationId])
  @@index([adminUserId, leftAt, conversationId])
  @@index([tags], type: Gin)
  @@map("conversation_participants")
}

model Message {
  id                  String      @id @default(uuid()) @db.Uuid
  conversationId      String      @map("conversation_id") @db.Uuid
  senderParticipantId String?     @map("sender_participant_id") @db.Uuid
  clientMessageId     String?     @map("client_message_id") @db.VarChar(100)
  type                MessageType @default(TEXT)
  content             String?     @db.Text
  replyToMessageId    String?     @map("reply_to_message_id") @db.Uuid
  systemEventType     String?     @map("system_event_type") @db.VarChar(120)
  metadata            Json?
  createdAt           DateTime    @default(now()) @map("created_at")
  editedAt            DateTime?   @map("edited_at")
  deletedAt           DateTime?   @map("deleted_at")

  conversation          Conversation              @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Restrict)
  latestForConversation Conversation?             @relation("ConversationLatestMessage")
  senderParticipant     ConversationParticipant?  @relation("ParticipantSentMessages", fields: [senderParticipantId], references: [id], onDelete: Restrict)
  readByParticipants    ConversationParticipant[] @relation("ParticipantLastReadMessage")
  replyToMessage        Message?                  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies               Message[]                 @relation("MessageReplies")
  attachments           MessageAttachment[]
  talentContactAttempt  TalentContactAttempt?

  @@unique([senderParticipantId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([replyToMessageId])
  @@map("messages")
}

model MessageAttachment {
  id                      String                  @id @default(uuid()) @db.Uuid
  conversationId          String                  @map("conversation_id") @db.Uuid
  fileAssetId             String                  @unique @map("file_asset_id") @db.Uuid
  uploadedByParticipantId String                  @map("uploaded_by_participant_id") @db.Uuid
  messageId               String?                 @map("message_id") @db.Uuid
  status                  MessageAttachmentStatus @default(UPLOADED)
  createdAt               DateTime                @default(now()) @map("created_at")
  claimedAt               DateTime?               @map("claimed_at")
  deletedAt               DateTime?               @map("deleted_at")

  conversation          Conversation            @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  fileAsset             FileAsset               @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  uploadedByParticipant ConversationParticipant @relation(fields: [uploadedByParticipantId], references: [id], onDelete: Restrict)
  message               Message?                @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, status, createdAt])
  @@index([messageId])
  @@map("message_attachments")
}

model ApplicationAssignment {
  id                  String    @id @default(uuid()) @db.Uuid
  applicationId       String    @map("application_id") @db.Uuid
  recruiterAccountId  String    @map("recruiter_account_id") @db.Uuid
  assignedByActorType ActorType @map("assigned_by_actor_type")
  assignedByActorId   String?   @map("assigned_by_actor_id") @db.Uuid
