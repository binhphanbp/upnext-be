  recruiterAccount RecruiterAccount @relation(fields: [recruiterAccountId], references: [id], onDelete: Restrict)

  @@index([applicationId, unassignedAt])
  @@index([recruiterAccountId, unassignedAt, applicationId])
  @@map("application_assignments")
}

