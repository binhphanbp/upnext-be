model ApplicationAiScore {
  id                 String   @id @default(uuid()) @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  applicationId      String   @unique @map("application_id") @db.Uuid
  jobPostId          String   @map("job_post_id") @db.Uuid
  candidateProfileId String   @map("candidate_profile_id") @db.Uuid
  aiScore            Decimal  @map("ai_score") @db.Decimal(5, 2)
  finalScore         Decimal  @map("final_score") @db.Decimal(5, 2)
  skillScore         Decimal  @map("skill_score") @db.Decimal(5, 2)
  experienceScore    Decimal  @map("experience_score") @db.Decimal(5, 2)
  projectScore       Decimal  @map("project_score") @db.Decimal(5, 2)
  educationScore     Decimal  @map("education_score") @db.Decimal(5, 2)
  matchedSkills      Json     @map("matched_skills")
  missingSkills      Json     @map("missing_skills")
  strengths          Json
  weaknesses         Json
  summary            String?  @db.Text
  recommendation     String?  @db.Text
  rawAiResponse      Json?    @map("raw_ai_response")
  /// Snapshot of the point weights this score was computed with, e.g.
  /// {"skills":40,"experience":30,"projects":20,"education":10}. null on rows
  /// scored before configurable weights existed -- readers fall back to the
  /// reference rubric, which is exactly what those rows used.
  scoringWeights     Json?    @map("scoring_weights")
  /// Per-criterion verdicts, e.g. [{"criterion":"2 năm React","met":false,
  /// "evidence":"..."}]. Missing must-haves are a warning, never a veto.
  mustHaveResults    Json?    @map("must_have_results")
  niceToHaveResults  Json?    @map("nice_to_have_results")
  /// Hash of the config inputs that change the model's output (criteria +
  /// custom prompt + scoring version). Weights are deliberately excluded, so
  /// a weight change re-weights this row locally instead of re-calling the AI.
  promptFingerprint  String?  @map("prompt_fingerprint") @db.VarChar(64)
  modelName          String   @map("model_name") @db.VarChar(120)
  scoringVersion     String   @map("scoring_version") @db.VarChar(40)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  run              CvScreeningRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobPost          JobPost          @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([runId, finalScore])
  @@index([jobPostId, finalScore])
  @@index([candidateProfileId])
  @@map("application_ai_scores")
}

model ApplicationStatusLog {
