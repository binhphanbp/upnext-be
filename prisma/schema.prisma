  REJECTED  @map("rejected")
}

enum AppealStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum JobBoostStatus {
  SCHEDULED @map("scheduled")
  ACTIVE    @map("active")
  ENDED     @map("ended")
  CANCELLED @map("cancelled")
}

/// Hai nhãn UI khác nhau ("Nổi bật" vs "Tuyển gấp"), dùng chung một hạn mức
/// `featured_job` -- `urgent_label` không có feature key riêng, theo quyết
/// định đã chốt ở mục 14 kế hoạch nghiệp vụ.
enum JobBoostType {
  FEATURED @map("featured")
  URGENT   @map("urgent")
}

/// Lý do một boost kết thúc trước khi hết vòng đời tự nhiên. `EXPIRED` là
/// đường mặc định (cron `JobBoostExpirationService`); các giá trị còn lại ghi
/// nhận lý do chủ động -- quyết định hoàn/không hoàn credit (mục 4.3 kế
/// hoạch) chỉ áp dụng cho `RECRUITER_STOPPED`.
enum JobBoostEndedReason {
  EXPIRED             @map("expired")
  RECRUITER_STOPPED   @map("recruiter_stopped")
  JOB_CLOSED          @map("job_closed")
  JOB_EXPIRED         @map("job_expired")
  JOB_HIDDEN          @map("job_hidden")
  MODERATION_REJECTED @map("moderation_rejected")
  ADMIN_CANCELLED     @map("admin_cancelled")
}

enum JobBoostPlacement {
  SEARCH   @map("search")
  HOMEPAGE @map("homepage")
}

enum JobBoostEventType {
  IMPRESSION @map("impression")
  CLICK      @map("click")
}

enum CompanyMemberStatus {
  ACTIVE  @map("active")
  INVITED @map("invited")
  REMOVED @map("removed")
}

enum MockInterviewStatus {
  STARTED   @map("started")
  COMPLETED @map("completed")
  CANCELED  @map("canceled")
}

enum CvScreeningRunStatus {
  PENDING        @map("pending")
