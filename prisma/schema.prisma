// UpNext - Prisma schema for PostgreSQL
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =========================
// Enums
// =========================

