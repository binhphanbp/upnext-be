/// Per-company defaults for the "AI lọc CV" screening behaviour: how the 100
/// points are split between the four rubric groups, plus the recruiter's real
/// hiring criteria. Absent (no row) or a null field means "use the system
/// defaults" (see screening-config.resolver.ts), so a company never has to
/// configure anything. A single job post can override any of this -- see
/// JobPostCvScreeningConfig. How many CVs a run scores is chosen per run on
/// the screening screen (Top 10/Top 20), not configured here.
model CvScreeningCompanyConfig {
  companyId          String  @id @map("company_id") @db.Uuid
  /// Point weights per rubric group; they must be multiples of 5 and sum to
  /// 100. Weights are applied AFTER the model scores a CV on the fixed
  /// reference rubric (scoring-rubric.ts), never inside the prompt, so
  /// changing them re-ranks existing results without another AI call. All
  /// four are set together or all null (= inherit the 40/30/20/10 default).
  weightSkills       Int?    @map("weight_skills")
  weightExperience   Int?    @map("weight_experience")
  weightProjects     Int?    @map("weight_projects")
  weightEducation    Int?    @map("weight_education")
  /// Which preset the weights came from: FRESHER | MID | SENIOR | CUSTOM.
  /// Display-only, so the UI can re-select the right preset card.
  weightPreset       String? @map("weight_preset") @db.VarChar(20)
  /// Deal-breakers, e.g. ["Ít nhất 2 năm React", "Tiếng Anh giao tiếp tốt"].
  /// The model reports met/unmet per criterion; a miss is surfaced as a
  /// warning and reflected in the related rubric items, it does not veto.
  mustHaveCriteria   Json?   @map("must_have_criteria")
  /// Bonus criteria the model credits within preferred-skills / domain.
  niceToHaveCriteria Json?   @map("nice_to_have_criteria")
  /// One free-text note appended to the AI prompt. Treated as untrusted
  /// recruiter input -- see gemini-scoring.service.ts buildSystemInstruction.
  customPrompt       String? @map("custom_prompt") @db.Text

  updatedByAccountId String?  @map("updated_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("cv_screening_company_configs")
}

/// Per-job-post override of the company's AI screening config. Every field is
/// optional: a null field inherits the company value (and in turn the system
/// default). Weights are an atomic block -- either all four are set here or
/// the job inherits the company's split entirely.
model JobPostCvScreeningConfig {
  jobPostId          String  @id @map("job_post_id") @db.Uuid
  weightSkills       Int?    @map("weight_skills")
  weightExperience   Int?    @map("weight_experience")
  weightProjects     Int?    @map("weight_projects")
  weightEducation    Int?    @map("weight_education")
  weightPreset       String? @map("weight_preset") @db.VarChar(20)
  mustHaveCriteria   Json?   @map("must_have_criteria")
  niceToHaveCriteria Json?   @map("nice_to_have_criteria")
  customPrompt       String? @map("custom_prompt") @db.Text

  updatedByAccountId String?  @map("updated_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  jobPost JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@map("job_post_cv_screening_configs")
}

