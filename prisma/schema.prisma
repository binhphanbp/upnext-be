model CvScreeningRun {
  id                 String               @id @default(uuid()) @db.Uuid
  jobPostId          String               @map("job_post_id") @db.Uuid
  companyId          String               @map("company_id") @db.Uuid
  recruiterAccountId String               @map("recruiter_account_id") @db.Uuid
  totalApplications  Int                  @default(0) @map("total_applications")
  processedCount     Int                  @default(0) @map("processed_count")
  failedCount        Int                  @default(0) @map("failed_count")
  limit              Int?
  applicationIds     Json                 @default("[]") @map("application_ids")
  /// Resolved screening config (job override merged over company defaults)
  /// captured when the run was created, so a config edit mid-run can't change
  /// how the run scores, and so a finished run stays explainable.
  configSnapshot     Json?                @map("config_snapshot")
  status             CvScreeningRunStatus @default(PENDING)
  attemptCount       Int                  @default(0) @map("attempt_count")
  nextAttemptAt      DateTime             @default(now()) @map("next_attempt_at")
  lockedAt           DateTime?            @map("locked_at")
  lockedBy           String?              @map("locked_by") @db.VarChar(100)
  errorMessage       String?              @map("error_message") @db.Text
  /// Đặt khi recruiter bấm hủy một run đang PROCESSING -- worker kiểm tra cờ
  /// này giữa các batch và dừng lại sớm thay vì chờ chấm hết toàn bộ CV.
  cancelRequestedAt  DateTime?            @map("cancel_requested_at")
  startedAt          DateTime?            @map("started_at")
  finishedAt         DateTime?            @map("finished_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  jobPost          JobPost              @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterAccount RecruiterAccount     @relation(fields: [recruiterAccountId], references: [id], onDelete: Cascade)
  aiScores         ApplicationAiScore[]

  @@index([jobPostId, createdAt])
  @@index([companyId, createdAt])
  @@index([recruiterAccountId, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, lockedAt])
  @@map("cv_screening_runs")
}

model JobEmbedding {
