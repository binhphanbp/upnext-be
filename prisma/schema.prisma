/// Candidate response to a formal offer. The application remains OFFERED until
/// the recruiter records the final hiring decision, so a declined offer never
/// masquerades as a recruiter rejection.
enum OfferResponse {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  DECLINED @map("declined")
}

enum ActorType {
  CANDIDATE @map("candidate")
  RECRUITER @map("recruiter")
  ADMIN     @map("admin")
  SYSTEM    @map("system")
}

enum InterviewType {
  ONLINE @map("online")
  ONSITE @map("onsite")
}

enum InterviewStatus {
  SCHEDULED   @map("scheduled") // đã lên lịch
  RESCHEDULED @map("rescheduled") // đã dời lịch
  COMPLETED   @map("completed") // hoàn thành
  CANCELLED   @map("cancelled") //Đã hủy bỏ
  NO_SHOW     @map("no_show") // Không có mặt
}

enum InterviewResult {
