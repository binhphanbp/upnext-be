/// A sandbox checkout is deliberately separate from an invoice.  It gives the
/// product a safe, idempotent purchase lifecycle before a real payment
/// provider is introduced.
enum SubscriptionCheckoutStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

