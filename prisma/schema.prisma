// UpNext - Prisma schema for PostgreSQL
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =========================
// Enums
// =========================

enum AuthProvider {
  DEFAULT  @map("default")
  GOOGLE   @map("google")
  GITHUB   @map("github")
  LINKEDIN @map("linkedin")
}

enum AccountStatus {
  ACTIVE               @map("active")
  BANNED               @map("banned")
  PENDING_VERIFICATION @map("pending_verification")
}

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")
}

enum JobSearchStatus {
  OPEN_TO_WORK @map("open_to_work")
  NOT_LOOKING  @map("not_looking")
}

enum ProfileVisibility {
  PUBLIC  @map("public")
