model Report {
  id                         String       @id @default(uuid()) @db.Uuid
  /// Which kind of actor filed this. Stored rather than derived from whichever
  /// reporter FK is set, because those use SetNull — deleting a recruiter account
  /// would otherwise silently reclassify their reports as candidate-filed.
  reporterType               ActorType    @map("reporter_type")
  evidenceFileId             String?      @map("evidence_file_id") @db.Uuid
  reporterCandidateId        String?      @map("reporter_candidate_id") @db.Uuid
  reporterRecruiterAccountId String?      @map("reporter_recruiter_account_id") @db.Uuid
  handledByAdminId           String?      @map("handled_by_admin_id") @db.Uuid
  targetType                 String       @map("target_type") @db.VarChar(80)
  targetId                   String       @map("target_id") @db.Uuid
  reason                     String       @db.Text
  status                     ReportStatus @default(PENDING)
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  evidenceFile             FileAsset?        @relation("ReportEvidenceFile", fields: [evidenceFileId], references: [id], onDelete: SetNull)
  reporterCandidate        CandidateProfile? @relation(fields: [reporterCandidateId], references: [id], onDelete: SetNull)
  reporterRecruiterAccount RecruiterAccount? @relation(fields: [reporterRecruiterAccountId], references: [id], onDelete: SetNull)
  handledByAdmin           AdminUser?        @relation("ReportHandledByAdmin", fields: [handledByAdminId], references: [id], onDelete: SetNull)

  /// Postgres treats NULLs as distinct, so this only constrains recruiter-filed
  /// reports — one per recruiter per target — and leaves candidate reports alone.
  @@unique([targetType, targetId, reporterRecruiterAccountId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterType])
  @@map("reports")
}

model Appeal {
  id                 String       @id @default(uuid()) @db.Uuid
  handledByAdminId   String?      @map("handled_by_admin_id") @db.Uuid
  recruiterAccountId String       @map("recruiter_account_id") @db.Uuid
  evidenceFileId     String?      @map("evidence_file_id") @db.Uuid
  targetType         String       @map("target_type") @db.VarChar(80)
  targetId           String       @map("target_id") @db.Uuid
  content            String       @db.Text
  status             AppealStatus @default(PENDING)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  handledByAdmin   AdminUser?       @relation("AppealHandledByAdmin", fields: [handledByAdminId], references: [id], onDelete: SetNull)
  recruiterAccount RecruiterAccount @relation(fields: [recruiterAccountId], references: [id], onDelete: Cascade)
  evidenceFile     FileAsset?       @relation("AppealEvidenceFile", fields: [evidenceFileId], references: [id], onDelete: SetNull)

  @@index([recruiterAccountId])
  @@index([targetType, targetId])
  @@map("appeals")
}

// =========================
// Monetization / boost module
// =========================

model SubscriptionPlan {
  id               String       @id @default(uuid()) @db.Uuid
  createdByAdminId String?      @map("created_by_admin_id") @db.Uuid
  /// Stable, audience-namespaced identifier (RECRUITER_PRO, CANDIDATE_TALENT, ...).
  /// Namespaced because "Pro" is a tier name on both sides of the pricing table.
  code             String?      @unique @db.VarChar(60)
  audience         PlanAudience @default(RECRUITER)
  subscriptionName String       @map("subscription_name") @db.VarChar(150)
  price            Decimal      @db.Decimal(12, 2)
  description      String?      @db.Text
  durationDays     Int          @map("duration_days")
  /// Controls visibility on the public pricing page, independent of `status`.
  isPublic         Boolean      @default(true) @map("is_public")
  /// Optional badge such as "Phổ biến nhất" rendered on the pricing card.
  highlightLabel   String?      @map("highlight_label") @db.VarChar(60)
  sortOrder        Int          @default(0) @map("sort_order")

  boostCreditLimit   Int                @default(0) @map("boost_credit_limit")
  status             SubscriptionStatus @default(ACTIVE)
  /// Legacy snapshot only. Recruiter job posts are a platform entitlement and are never capped.
  jobPostLimit       Int                @default(0) @map("job_post_limit")
  talentContactLimit Int                @default(0) @map("talent_contact_limit")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  createdByAdmin         AdminUser?              @relation("SubscriptionPlanCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  companySubscriptions   CompanySubscription[]
  candidateSubscriptions CandidateSubscription[]
  invoices               Invoice[]
  features               PlanFeature[]
  checkouts              SubscriptionCheckout[]

  @@index([audience, isPublic, status])
  @@map("subscription_plans")
}

/// Per-plan quota definition. Replaces the hard-coded *Limit columns so adding a
/// metered feature is a data change, not a migration.
model PlanFeature {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  feature    String   @db.VarChar(60)
  enabled    Boolean  @default(true)
  /// null = unlimited. 0 = feature present but no allowance.
  limitValue Int?     @map("limit_value")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@map("plan_features")
}

model CompanySubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  /// Legacy snapshot fields retained for historical subscriptions; no longer used for access control.
  jobPostLimit       Int                @map("job_post_limit")
  jobPostUsed        Int                @default(0) @map("job_post_used")
  boostCreditTotal   Int                @default(0) @map("boost_credit_total")
  boostCreditUsed    Int                @default(0) @map("boost_credit_used")
  talentContactLimit Int                @default(0) @map("talent_contact_limit")
  talentContactUsed  Int                @default(0) @map("talent_contact_used")
  startedAt          DateTime           @default(now()) @map("started_at")
  expiredAt          DateTime           @map("expired_at")
  /// Quota window. Separate from startedAt/expiredAt so a longer-than-monthly
  /// plan can still reset allowances every cycle.
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelRequestedAt  DateTime?          @map("cancel_requested_at")
  /// FREE_PROVISION, SANDBOX_CHECKOUT, ADMIN_GRANT or LEGACY.  This remains a
  /// string so new sources do not require a database enum migration.
  source             String             @default("LEGACY") @db.VarChar(50)
  planSnapshot       Json?              @map("plan_snapshot")
  status             SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  plan          SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobBoosts     JobBoost[]
  usages        SubscriptionUsage[]
  supportCases  SupportCase[]
  quotaCounters SubscriptionQuotaCounter[]

  @@index([companyId, status])
  @@index([expiredAt])
  @@map("company_subscriptions")
}

/// Candidate entitlement. Recruiter and candidate subscriptions share the
/// plan catalogue and feature definitions, but keep their owner records and
/// ledgers separate so that billing, privacy and access rules cannot leak
/// across audiences.
model CandidateSubscription {
  id                 String             @id @default(uuid()) @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  candidateProfileId String             @map("candidate_profile_id") @db.Uuid
  startedAt          DateTime           @default(now()) @map("started_at")
  expiredAt          DateTime           @map("expired_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelRequestedAt  DateTime?          @map("cancel_requested_at")
  source             String             @default("LEGACY") @db.VarChar(50)
  planSnapshot       Json?              @map("plan_snapshot")
  status             SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  plan             SubscriptionPlan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  candidateProfile CandidateProfile                    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  usages           CandidateSubscriptionUsage[]
  quotaCounters    CandidateSubscriptionQuotaCounter[]

  @@index([candidateProfileId, status])
  @@index([expiredAt])
  @@map("candidate_subscriptions")
}

/// Generic ownership intentionally avoids coupling a checkout to both the
/// company and candidate tables.  `ownerId` is the company id for RECRUITER
/// and candidate profile id for CANDIDATE; authorization is always resolved
/// by the service before querying this record.
model SubscriptionCheckout {
  id                 String                     @id @default(uuid()) @db.Uuid
  audience           PlanAudience
  ownerId            String                     @map("owner_id") @db.Uuid
  subscriptionPlanId String                     @map("subscription_plan_id") @db.Uuid
  planSnapshot       Json                       @map("plan_snapshot")
  amount             Decimal                    @db.Decimal(12, 2)
  currency           String                     @default("VND") @db.VarChar(10)
  status             SubscriptionCheckoutStatus @default(PENDING)
  provider           String                     @default("SANDBOX") @db.VarChar(50)
  idempotencyKey     String                     @map("idempotency_key") @db.VarChar(180)
  actorType          ActorType?                 @map("actor_type")
  actorId            String?                    @map("actor_id") @db.Uuid
  subscriptionId     String?                    @map("subscription_id") @db.Uuid
  completedAt        DateTime?                  @map("completed_at")
  cancelledAt        DateTime?                  @map("cancelled_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)

  @@unique([audience, ownerId, idempotencyKey])
  @@index([audience, ownerId, status])
  @@index([subscriptionPlanId])
  @@index([audience, ownerId, subscriptionId])
  @@map("subscription_checkouts")
}

/// Append-only lifecycle evidence.  It is intentionally not a replacement for
/// quota ledgers: this answers "why is this plan active?", while usage rows
/// answer "where was an allowance spent?".
model SubscriptionLifecycleEvent {
  id                 String       @id @default(uuid()) @db.Uuid
  audience           PlanAudience
  ownerId            String       @map("owner_id") @db.Uuid
  eventType          String       @map("event_type") @db.VarChar(80)
  subscriptionPlanId String?      @map("subscription_plan_id") @db.Uuid
  checkoutId         String?      @map("checkout_id") @db.Uuid
  actorType          ActorType?   @map("actor_type")
  actorId            String?      @map("actor_id") @db.Uuid
  metadata           Json?
  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([audience, ownerId, createdAt])
  @@index([checkoutId])
  @@map("subscription_lifecycle_events")
}

/// Per-period materialised counter for a candidate entitlement. The same
/// conditional-update approach as recruiter quota counters keeps concurrent
/// Copilot requests from overspending a limited allowance.
model CandidateSubscriptionQuotaCounter {
  id                      String   @id @default(uuid()) @db.Uuid
  candidateSubscriptionId String   @map("candidate_subscription_id") @db.Uuid
  feature                 String   @db.VarChar(60)
  limitValue              Int?     @map("limit_value")
  usedValue               Int      @default(0) @map("used_value")
  periodStart             DateTime @map("period_start")
  periodEnd               DateTime @map("period_end")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  candidateSubscription CandidateSubscription @relation(fields: [candidateSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([candidateSubscriptionId, feature, periodStart], map: "candidate_sub_quota_counter_period_uq")
  @@index([candidateSubscriptionId, feature], map: "candidate_sub_quota_counter_subscription_feature_idx")
  @@map("candidate_subscription_quota_counters")
}

/// Immutable candidate usage ledger. A reversal is linked to its original
/// consume row, making retries and failed AI runs auditable and idempotent.
model CandidateSubscriptionUsage {
  id                      String                     @id @default(uuid()) @db.Uuid
  candidateSubscriptionId String                     @map("candidate_subscription_id") @db.Uuid
  candidateProfileId      String                     @map("candidate_profile_id") @db.Uuid
  feature                 String                     @db.VarChar(60)
  quantity                Int
  direction               SubscriptionUsageDirection
  referenceType           String                     @map("reference_type") @db.VarChar(80)
  referenceId             String                     @map("reference_id") @db.Uuid
  idempotencyKey          String                     @unique(map: "candidate_sub_usage_idempotency_key_uq") @map("idempotency_key") @db.VarChar(180)
  reversedUsageId         String?                    @unique(map: "candidate_sub_usage_reversed_usage_id_uq") @map("reversed_usage_id") @db.Uuid
  createdAt               DateTime                   @default(now()) @map("created_at")

  candidateSubscription CandidateSubscription       @relation(fields: [candidateSubscriptionId], references: [id], onDelete: Restrict)
  candidateProfile      CandidateProfile            @relation(fields: [candidateProfileId], references: [id], onDelete: Restrict)
  reversedUsage         CandidateSubscriptionUsage? @relation("CandidateSubscriptionUsageReversal", fields: [reversedUsageId], references: [id], onDelete: SetNull)
  reversal              CandidateSubscriptionUsage? @relation("CandidateSubscriptionUsageReversal")

  @@index([candidateProfileId, feature, createdAt], map: "candidate_sub_usage_profile_feature_created_idx")
  @@index([candidateSubscriptionId, feature, createdAt], map: "candidate_sub_usage_subscription_feature_created_idx")
  @@map("candidate_subscription_usages")
}

/// Materialised per-period counter. Quota is consumed with a conditional
/// `updateMany` against `usedValue`, which is what makes concurrent consumption
/// race-safe without a row lock. A new period is a new row, so resetting
/// allowances needs no scheduled job.
model SubscriptionQuotaCounter {
  id                    String   @id @default(uuid()) @db.Uuid
  companySubscriptionId String   @map("company_subscription_id") @db.Uuid
  feature               String   @db.VarChar(60)
  /// Mirrored from PlanFeature at period start; null = unlimited.
  limitValue            Int?     @map("limit_value")
  usedValue             Int      @default(0) @map("used_value")
  periodStart           DateTime @map("period_start")
  periodEnd             DateTime @map("period_end")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  companySubscription CompanySubscription @relation(fields: [companySubscriptionId], references: [id], onDelete: Cascade)

  @@unique([companySubscriptionId, feature, periodStart])
  @@index([companySubscriptionId, feature])
  @@map("subscription_quota_counters")
}

/// Raw AI spend ledger. Needed to verify the margin argument the pricing
/// proposal is built on (plan price minus real token cost).
model AiUsageLog {
  id            String     @id @default(uuid()) @db.Uuid
  feature       String     @db.VarChar(60)
  companyId     String?    @map("company_id") @db.Uuid
  actorType     ActorType? @map("actor_type")
  actorId       String?    @map("actor_id") @db.Uuid
  modelName     String     @map("model_name") @db.VarChar(120)
  inputTokens   Int?       @map("input_tokens")
  outputTokens  Int?       @map("output_tokens")
  /// Estimated cost in VND; nullable because token counts are not always returned.
  costEstimate  Decimal?   @map("cost_estimate") @db.Decimal(12, 4)
  referenceType String?    @map("reference_type") @db.VarChar(80)
  referenceId   String?    @map("reference_id") @db.Uuid
  succeeded     Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, feature, createdAt])
  @@index([feature, createdAt])
  @@map("ai_usage_logs")
}

/// Kết quả của một thao tác AI, lưu theo idempotency key để một retry của client
/// KHÔNG gọi lại model.
///
/// Quota đã idempotent từ trước, nhưng chi phí API thì không: `consume()` trả
/// `{ replayed: true }` khi key trùng, rồi caller vẫn chạy `run()` -- tức người dùng
/// không bị trừ quota hai lần nhưng UpNext vẫn trả tiền token hai lần. Bảng này là
/// chỗ `loadResult(prior)` mà khuôn `consume()` ở §9.2 kế hoạch nghiệp vụ để trống.
///
/// Có `expiresAt` vì payload là dữ liệu tạm, không phải sổ sách: nó chỉ cần sống đủ
/// lâu để phục vụ một lần retry. Dọn theo kiểu cơ hội lúc ghi, nên không cần cron.
model AiOperationResult {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(180)
  /// Ví dụ 'job_post_ai.generate' -- để đối soát và để biết payload có hình gì.
  operation      String   @db.VarChar(60)
  payload        Json
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("ai_operation_results")
}

model Invoice {
  id                 String         @id @default(uuid()) @db.Uuid
  subscriptionPlanId String         @map("subscription_plan_id") @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  invoiceCode        String         @unique @map("invoice_code") @db.VarChar(80)
  amount             Decimal        @db.Decimal(12, 2)
  paymentMethod      PaymentMethod? @map("payment_method")
  paymentStatus      PaymentStatus  @default(PENDING) @map("payment_status")
  /// Mã giao dịch / referenceCode do cổng thanh toán (SePay...) trả về khi webhook
  /// xác nhận -- phục vụ đối soát, không phải khoá nghiệp vụ.
  paymentReference   String?        @map("payment_reference") @db.VarChar(120)
  paidAt             DateTime?      @map("paid_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supportCases     SupportCase[]

  @@index([companyId, paymentStatus])
  @@map("invoices")
}

/// Cấu hình 1 cổng thanh toán, quản lý qua trang admin "Cấu hình thanh toán"
/// thay vì env var -- mỗi provider (SEPAY, PAYPAL, ...) có tối đa 1 dòng.
/// `webhookSecret` không bao giờ được trả nguyên vẹn qua API (chỉ dạng mask).
/// Với SEPAY đây là secret dùng để verify chữ ký HMAC-SHA256 của webhook
/// (không phải "API key" theo nghĩa gọi API SePay -- SePay chỉ gọi vào mình).
model PaymentGatewayConfig {
  id               String        @id @default(uuid()) @db.Uuid
  provider         PaymentMethod @unique
  isEnabled        Boolean       @default(false) @map("is_enabled")
  bankName         String?       @map("bank_name") @db.VarChar(120)
  bankBin          String?       @map("bank_bin") @db.VarChar(20)
  accountNumber    String?       @map("account_number") @db.VarChar(50)
  accountName      String?       @map("account_name") @db.VarChar(150)
  /// Bắt buộc phải xuất hiện trong nội dung chuyển khoản, đứng trước mã hoá
  /// đơn (vd "TKPUPN" khi dùng tính năng Virtual Account của SePay -- "TKP"
  /// là tiền tố cố định của SePay, "UPN" là mã VA do admin tự đặt). Để trống
  /// nếu tài khoản ngân hàng không dùng VA.
  contentPrefix    String?       @map("content_prefix") @db.VarChar(20)
  webhookSecret    String?       @map("webhook_secret") @db.VarChar(255)
  updatedByAdminId String?       @map("updated_by_admin_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  updatedByAdmin AdminUser? @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@map("payment_gateway_configs")
}

model JobBoost {
  id                    String               @id @default(uuid()) @db.Uuid
  createdByRecruiterId  String               @map("created_by_recruiter_id") @db.Uuid
  companySubscriptionId String               @map("company_subscription_id") @db.Uuid
  jobPostId             String               @map("job_post_id") @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  type                  JobBoostType         @default(FEATURED)
  status                JobBoostStatus       @default(SCHEDULED)
  endedReason           JobBoostEndedReason? @map("ended_reason")
  creditCost            Int                  @map("credit_cost")
  startsAt              DateTime             @map("starts_at")
  endsAt                DateTime             @map("ends_at")
  /// Khóa idempotency do client sinh (một lần bấm nút = một key), khớp với
  /// `SubscriptionUsage.idempotencyKey` của lượt tiêu quota gắn với boost này.
  idempotencyKey        String               @unique @map("idempotency_key") @db.VarChar(200)
  /// Mốc phân phối đầu/cuối -- quyết định chính sách hoàn credit khi dừng sớm
  /// (mục 4.3: đã có impression thì không hoàn) và chống double count.
  firstImpressionAt     DateTime?            @map("first_impression_at")
  lastImpressionAt      DateTime?            @map("last_impression_at")
  /// Mốc lượt phục vụ gần nhất -- khoá xoay vòng công bằng cho endpoint
  /// sponsored-jobs (`ORDER BY lastServedAt ASC`), mục 5.3.
  lastServedAt          DateTime?            @map("last_served_at")
  placementVersion      String               @default("v1") @map("placement_version") @db.VarChar(20)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  createdByRecruiter  RecruiterAccount        @relation("JobBoostCreatedByRecruiter", fields: [createdByRecruiterId], references: [id], onDelete: Restrict)
  companySubscription CompanySubscription     @relation(fields: [companySubscriptionId], references: [id], onDelete: Restrict)
  jobPost             JobPost                 @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metrics             JobBoostMetric[]
  deliveryEvents      JobBoostDeliveryEvent[]

  @@index([jobPostId, status])
  @@index([companyId])
  @@index([status, lastServedAt])
  @@map("job_boost")
}

model JobBoostMetric {
  id                String   @id @default(uuid()) @db.Uuid
  jobBoostId        String   @map("job_boost_id") @db.Uuid
  jobPostId         String   @map("job_post_id") @db.Uuid
  impressions       Int      @default(0)
  clicks            Int      @default(0)
  applicationsCount Int      @default(0) @map("applications")
  savedCount        Int      @default(0) @map("saved_count")
  date              DateTime @db.Date
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  jobBoost JobBoost @relation(fields: [jobBoostId], references: [id], onDelete: Cascade)
  jobPost  JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobBoostId, date])
  @@index([jobPostId, date])
  @@map("job_boost_metrics")
}

/// Chống bơm impression/click ảo (F5, bot) -- một `visitorHash` chỉ được tính
/// một lần cho mỗi (boost, placement, loại sự kiện, ngày). `visitorHash` là
/// hash một chiều của cookie/IP phía server sinh ra, không lưu định danh thật.
model JobBoostDeliveryEvent {
  id          String            @id @default(uuid()) @db.Uuid
  jobBoostId  String            @map("job_boost_id") @db.Uuid
  placement   JobBoostPlacement
  eventType   JobBoostEventType @map("event_type")
  visitorHash String            @map("visitor_hash") @db.VarChar(64)
  eventDate   DateTime          @map("event_date") @db.Date
  createdAt   DateTime          @default(now()) @map("created_at")

  jobBoost JobBoost @relation(fields: [jobBoostId], references: [id], onDelete: Cascade)

  @@unique([jobBoostId, placement, eventType, visitorHash, eventDate])
  @@index([jobBoostId, eventDate])
  @@map("job_boost_delivery_events")
}

model CompanyReputationActivity {
  id         String   @id @default(uuid()) @db.Uuid
  reason     String?  @db.Text
  companyId  String   @map("company_id") @db.Uuid
  actionType String   @map("action_type") @db.VarChar(80)
  score      Decimal  @db.Decimal(6, 2)
  byAdminId  String?  @map("by_admin_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  byAdmin AdminUser? @relation(fields: [byAdminId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("company_reputation_activities")
}

model TaxCodeBlacklist {
  id        String   @id @default(uuid()) @db.Uuid
  taxCode   String   @unique @map("tax_code") @db.VarChar(50)
  reason    String   @db.Text
  byAdminId String?  @map("by_admin_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  byAdmin AdminUser? @relation(fields: [byAdminId], references: [id], onDelete: SetNull)

  @@map("tax_code_blacklists")
}

model HiringResultReport {
  id                 String   @id @default(uuid()) @db.Uuid
  jobPostId          String   @unique @map("job_post_id") @db.Uuid
  recruiterAccountId String   @map("recruiter_account_id") @db.Uuid
  totalHired         Int      @default(0) @map("total_hired")
