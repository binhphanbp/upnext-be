}

enum CandidateContactPreferenceStatus {
  OPTED_OUT @map("opted_out")
  OPTED_IN  @map("opted_in")
}

enum SupportDepartment {
  SALES                @map("sales")
  BILLING              @map("billing")
  JOB_REVIEW           @map("job_review")
  COMPANY_VERIFICATION @map("company_verification")
  TECHNICAL            @map("technical")
  GENERAL              @map("general")
}

enum SupportCaseStatus {
  NEW                  @map("new")
  IN_PROGRESS          @map("in_progress")
  WAITING_ON_RECRUITER @map("waiting_on_recruiter")
