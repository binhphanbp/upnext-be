  introMessageId    String                      @unique @map("intro_message_id") @db.Uuid
  quotaUsageId      String                      @unique @map("quota_usage_id") @db.Uuid
  clientRequestId   String                      @map("client_request_id") @db.VarChar(100)
  sentAt            DateTime                    @default(now()) @map("sent_at")
  expiresAt         DateTime                    @map("expires_at")
  respondedAt       DateTime?                   @map("responded_at")
  outcome           TalentContactAttemptOutcome @default(PENDING)

  request           TalentContactRequest  @relation("TalentContactAttempts", fields: [requestId], references: [id], onDelete: Restrict)
  currentForRequest TalentContactRequest? @relation("CurrentTalentContactAttempt")
  sentByRecruiter   RecruiterAccount      @relation(fields: [sentByRecruiterId], references: [id], onDelete: Restrict)
  introMessage      Message               @relation(fields: [introMessageId], references: [id], onDelete: Restrict)
