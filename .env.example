NODE_ENV=production
APP_ENV=production
PORT=4000
UPLOAD_ROOT=/app/uploads
DATABASE_URL=postgresql://upnext:<password>@postgres:5432/upnext?schema=public
JWT_ACCESS_SECRET=<strong-access-token-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
APP_FRONTEND_URL=https://upnext.works
APP_BACKEND_URL=https://api.upnext.works
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
MAIL_FROM="UpNext <contact@upnext.works>"
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
CLOUDINARY_FOLDER=upnext
GEMINI_API_KEY=<gemini-api-key>
# Safe migration switch. Keep `gemini` until the private upnext-ai service is healthy.
AI_LLM_PROVIDER=gemini
# Only required when AI_LLM_PROVIDER=upnext-ai. Use an internal Docker URL, never a public route.
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_JWT_SECRET=<different-strong-internal-service-secret>
AI_SERVICE_TIMEOUT_MS=25000
AI_BATCH_SERVICE_TIMEOUT_MS=90000
AI_SERVICE_FALLBACK_TO_GEMINI=true
CORS_ORIGIN=https://upnext.works,https://staging.upnext.works
# Google OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials)
# The callback URI registered in Google Console must match:
#   ${APP_BACKEND_URL}/api/v1/candidate/auth/google/callback
#   ${APP_BACKEND_URL}/api/v1/recruiter/auth/google/callback
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
# Optional: Zalo Bot Platform (https://bot.zapps.me) for interview reminder notifications.
# Leave unset to disable this channel entirely (email + in-app reminders keep working).
ZALO_BOT_TOKEN=<zalo-bot-token>
ZALO_BOT_WEBHOOK_SECRET=<random-8-to-256-char-secret>
CHAT_APPLICATION_ENABLED=false
CHAT_OUTREACH_ENABLED=false
CHAT_SUPPORT_ENABLED=false

