NODE_ENV=production
APP_ENV=production
PORT=4000
UPLOAD_ROOT=/app/uploads
DATABASE_URL=postgresql://upnext:<password>@postgres:5432/upnext?schema=public
JWT_ACCESS_SECRET=<strong-access-token-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
APP_FRONTEND_URL=https://upnext.works
APP_BACKEND_URL=https://api.upnext.works
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
# Logo hiển thị trong header email. Để trống = nhúng inline qua cid (mặc định).
# Trỏ tới một URL công khai (ví dụ Cloudinary) nếu client email không hiện được ảnh cid.
MAIL_LOGO_URL=
# Link "hướng dẫn xác thực doanh nghiệp" trong email từ chối hồ sơ.
# Để trống = ẩn hẳn đoạn đó đi, tránh dẫn người nhận vào trang 404.
MAIL_VERIFICATION_GUIDE_URL=
MAIL_FROM="UpNext <contact@upnext.works>"
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
CLOUDINARY_FOLDER=upnext
GEMINI_API_KEY=<gemini-api-key>
# Safe migration switch. Keep `gemini` until the private upnext-ai service is healthy.
AI_LLM_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=gemini
# Recruiter JD generation is independently canaried. Keep `gemini` until the
# private capability has been evaluated; this does not affect Copilot, screening or import.
AI_JOB_POST_GENERATION_PROVIDER=gemini
# JD import has its own canary switch. Keep `gemini` until private extraction
# traffic has been evaluated; this does not affect Copilot or embeddings.
AI_JOB_POST_EXTRACTION_PROVIDER=gemini
# Business licence reading during company onboarding. Its own switch and its own
# JWT scope: a token allowed to read a JD must not also read a company's
# registration documents.
AI_COMPANY_LICENSE_PROVIDER=gemini
# Salary research: the only capability that answers from live web search rather than
# from the prompt. Its own switch and its own JWT scope, because each run fans out
# into several searches on a premium model.
AI_GROUNDED_RESEARCH_PROVIDER=gemini
# Required when any AI_*_PROVIDER is `upnext-ai`.
# Use an internal Docker URL, never a public route.
AI_SERVICE_URL=http://ai:8000
AI_INTERNAL_JWT_SECRET=<different-strong-internal-service-secret>
AI_SERVICE_TIMEOUT_MS=25000
AI_EMBEDDING_SERVICE_TIMEOUT_MS=20000
AI_JOB_POST_GENERATION_SERVICE_TIMEOUT_MS=45000
AI_JOB_POST_EXTRACTION_SERVICE_TIMEOUT_MS=45000
AI_COMPANY_LICENSE_SERVICE_TIMEOUT_MS=45000
# A grounded run measures 42-50s end to end; the 45s budgets above would abort most calls.
AI_GROUNDED_RESEARCH_SERVICE_TIMEOUT_MS=75000
AI_BATCH_SERVICE_TIMEOUT_MS=90000
AI_SERVICE_FALLBACK_TO_GEMINI=true
AI_EMBEDDING_FALLBACK_TO_GEMINI=true
# Each JD capability falls back only for service availability, timeout or rate-limit errors.
# A malformed structured answer is returned to the recruiter rather than silently regenerating
# a potentially different JD through another provider.
AI_JOB_POST_GENERATION_FALLBACK_TO_GEMINI=true
AI_JOB_POST_EXTRACTION_FALLBACK_TO_GEMINI=true
# Same rule for licences: fall back only on availability/timeout/rate-limit, never
# on a malformed answer -- onboarding verifies a company from these fields.
AI_COMPANY_LICENSE_FALLBACK_TO_GEMINI=true
# Same rule for salary research, and for one more reason: a grounded run is expensive,
# so an answer the service already rejected is not worth paying for twice.
AI_GROUNDED_RESEARCH_FALLBACK_TO_GEMINI=true
CORS_ORIGIN=https://upnext.works,https://staging.upnext.works
# Google OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials)
# The callback URI registered in Google Console must match:
#   ${APP_BACKEND_URL}/api/v1/candidate/auth/google/callback
#   ${APP_BACKEND_URL}/api/v1/recruiter/auth/google/callback
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
# Optional: Zalo Bot Platform (https://bot.zapps.me) for interview reminder notifications.
# Leave unset to disable this channel entirely (email + in-app reminders keep working).
ZALO_BOT_TOKEN=<zalo-bot-token>
ZALO_BOT_WEBHOOK_SECRET=<random-8-to-256-char-secret>
CHAT_APPLICATION_ENABLED=false
CHAT_OUTREACH_ENABLED=false
CHAT_SUPPORT_ENABLED=false

